\subsection{\texttt{data\_generator/generator.py}}
Feature-specific generation and noise application.

\begin{lstlisting}[language=Python, caption={DataGeneratorFactory + Noise Models}, label=lst:generators]
# data_generator/generator.py (simplified interface)
class DataGeneratorFactory:
    @staticmethod
    def get_generator(feature_type, rng):
        if feature_type == "categorical":
            return CategoricalGenerator(rng)
        elif feature_type == "numerical":
            return NumericalGenerator(rng)
        elif feature_type == "datetime":
            return DatetimeGenerator(rng)

class CategoricalGenerator:
    def apply_noise(self, values, feat_config):
        # With missing_rate -> NaN
        # With prob (1-missing) * (1/num_classes) -> random other class
        # Else -> keep true value
        pass

class NumericalGenerator:
    def apply_noise(self, values, feat_config):
        # values + N(0, sigma^2); missing_rate -> NaN
        pass

class DatetimeGenerator:
    def apply_noise(self, values, feat_config):
        # values + N(0, sigma_hours^2); missing_rate -> NaT
        pass
\end{lstlisting}

\section{Configuration Variants}
\label{annex:config_variants}

\begin{itemize}
    \item \texttt{smallestest\_config.yaml}: $N=100$, rows 100/120 (fastest)
    \item \texttt{smaller\_config.yaml}: $N=1000$, rows 100/120 (standard)
    \item \texttt{small\_config.yaml}: $N=5000$, rows 100/120 (scale)
    \item \texttt{med\_30\_overlap\_config.yaml}: $N=10000$, overlap 30\%
    \item \texttt{low\_card\_config.yaml}: $N=100$, rows 5/5 (cardinality extreme)
    \item \texttt{c2\_config.yaml}: $N=1000$, rows 200/200 (high cardinality)
    \item \texttt{o50\_config.yaml}: $N=1000$, overlap 50\%
\end{itemize}