\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Framework 1 (Score Aggregation). Records are compared pairwise by Fellegi-Sunter, producing per-field comparison levels $\gamma _k$ and a matrix of match probabilities $P$ per global entity pair. Scalar aggregation (e.g., Noisy-OR) yields a global score. For $(e_1,e_1)$, multiple corroborating buy-buy pairs drive the score $\approx 1$; for $(e_2,e_2)$, a single buy-sell mismatch yields a low score.\relax }}{9}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:framework1_score_agg}{{1}{9}{Framework 1 (Score Aggregation). Records are compared pairwise by Fellegi-Sunter, producing per-field comparison levels $\gamma _k$ and a matrix of match probabilities $P$ per global entity pair. Scalar aggregation (e.g., Noisy-OR) yields a global score. For $(e_1,e_1)$, multiple corroborating buy-buy pairs drive the score $\approx 1$; for $(e_2,e_2)$, a single buy-sell mismatch yields a low score.\relax }{figure.caption.1}{}}
\newlabel{fig:framework1_score_agg@cref}{{[figure][1][]1}{[1][8][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Framework 2 (Profile Aggregation). Records are first aggregated per entity into profiles (sets of actions, datetime ranges, frequency vectors). Set similarity metrics (Soft Jaccard, Monge-Elkan, Simpson, Range Overlap) compute per-dimension similarities $\mathbf  {x} = (x_1,\dots  ,x_D)$. A Fellegi-Sunter model then learns discriminative weights and outputs calibrated posteriors. For $(e_1,e_1)$, overlapping actions and close datetimes yield high similarity; for $(e_2,e_2)$, disjoint actions yield near-zero similarity.\relax }}{9}{figure.caption.2}\protected@file@percent }
\newlabel{fig:framework2_profile_agg}{{2}{9}{Framework 2 (Profile Aggregation). Records are first aggregated per entity into profiles (sets of actions, datetime ranges, frequency vectors). Set similarity metrics (Soft Jaccard, Monge-Elkan, Simpson, Range Overlap) compute per-dimension similarities $\mathbf {x} = (x_1,\dots ,x_D)$. A Fellegi-Sunter model then learns discriminative weights and outputs calibrated posteriors. For $(e_1,e_1)$, overlapping actions and close datetimes yield high similarity; for $(e_2,e_2)$, disjoint actions yield near-zero similarity.\relax }{figure.caption.2}{}}
\newlabel{fig:framework2_profile_agg@cref}{{[figure][2][]2}{[1][8][]9}}
