\subsubsection{Scale-Up: \texttt{smaller}, \texttt{small}, \texttt{med\_30\_overlap}}
\label{sec:scale_up}
\begin{itemize}
    \item \texttt{EM\_smallest}: Baseline minimal config.
    \item \texttt{small}: 50$\times$ entities; tests blocking scalability.
    \item \texttt{med\_30\_overlap}: 30\% overlap; tests higher prior $\pi$.
    \item \texttt{c2}: Double cardinality (200/200); tests combinatorial growth.
    \item \texttt{o50}: 50\% overlap; tests high-$\pi$ regime.
\end{itemize}

\subsection{Experiment 2: Sensitivity Analysis}
\label{sec:sensitivity}

\subsubsection{Blocking Rule Sensitivity}
\label{sec:sensitivity_blocking}
\begin{description}
    \item[\textbf{Strictest Rules}] Conjunction of exact category + $\le 10\%$ numerical + $\le 1$ day datetime.
    Used for initial $\pi$ estimate. High precision, unknown recall.
    \item[\textbf{Disjunctive Rules} (\Cref{lst:blocking_rules})] Union of 5 rules covering category, month, numerical 25\%, date $\pm$15 days.
    \item[\textbf{Varying Target Recall}] $\pi$ estimation with recall $\in \{0.7, 0.9, 0.99\}$.
    \item[\textbf{Results}] \textit{TBD: Fill in from \texttt{splink\_c2}, \texttt{splink\_o50}, \texttt{splink\_small} notebooks.}
\end{description}

\subsubsection{Data Generation Hyperparameter Sensitivity}
\label{sec:sensitivity_datagen}
\begin{description}
    \item[\textbf{Noise Level ($\sigma$)}] Higher $\sigma$ $\to$ lower separation in match weights.
    \item[\textbf{Missing Rate}] Higher missing $\to$ more null-level comparisons $\to$ less signal.
    \item[\textbf{Cardinality (rows/entity)}] Higher cardinality $\to$ more local pairs per global pair $\to$ aggregation benefits but also more computation.
    \item[\textbf{Overlap \%}] Higher overlap $\to$ higher $\pi$ $\to$ easier \emalgo{} convergence, more matches to find.
    \item[\textbf{Results}] \textit{TBD: Systematic sweep across configs.}
\end{description}

\subsection{Experiment 3: Public Dataset Validation}
\label{sec:public_datasets}

\subsubsection{DBLP-ACM (\texttt{splink\_dblp\_acm.ipynb})}
\label{sec:dblp_acm}
\begin{itemize}
    \item Bibliographic records: title, authors, venue, year.
    \item Known overlap $\sim$15\%.
    \item \splink{} config: Jaro-Winkler on title/authors, exact on year/venue.
    \item Blocking: Title tokens + year.
    \item Results: \textit{TBD: Precision/recall bounds from blocking analysis.}
\end{itemize}

\subsubsection{MusicBrainz (\texttt{splink\_music.ipynb}, \texttt{agg\_music.ipynb})}
\label{sec:music}
\begin{itemize}
    \item Two music catalogs (catalog 3 vs catalog 5), ~3,900 and ~3,800 artists.
    \item Multi-record per artist (multiple tracks/releases).
    \item Attributes: title (set), album (set), track number (set), length (numeric), language (set), year (set).
    \item Aggregation profile: \texttt{artist} as unique\_id.
    \item Local layer: Soft Jaccard on title/album, Simpson on track number, year overlap, numerical range overlap on length.
    \item Blocking: At least one intersecting track number.
    \item \emalgo{} converged with 4 training rules.
    \item Optimal threshold: $p \ge 0.8966$, Max $F_1 = 0.6087$ (Precision 0.5375, Recall 0.7018).
    \item Global aggregation: Vector-space profiles $\to$ second \splink{} layer (behavioural aggregation).
\end{itemize}

