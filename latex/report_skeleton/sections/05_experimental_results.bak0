\section{Experimental Results \& Discussion}
\label{sec:results}

\subsection{Experiment 1a: Artificial Baseline — Local Matching into Global Aggregation}
\label{sec:exp_baseline}

\subsubsection{\texttt{smallestest} Config (100 Entities, 10\% Overlap, Cardinality 100/120)}
\label{sec:smallestest_baseline}

\textbf{Local Layer Results} (\texttt{splink\_process.ipynb}):
\begin{itemize}
    \item Cartesian product: $1,332 \times 1,644 = 2,189,808$ pairs.
    \item Blocking rules (\Cref{lst:blocking_rules}) reduce to $\sim$X pairs (cumulative comparison chart).
    \item \emalgo{} training: Converged in 16 iterations (date block) + 25 iterations (categorical block).
    \item Match weight separation: Clear bimodal distribution (matches $\sim$+2, non-matches $\sim$-30).
    \item Optimal local threshold (max $F_1$): $p \ge 0.8966$, $F_1 = 0.6087$, Precision $= 0.5375$, Recall $= 0.7018$.
\end{itemize}

