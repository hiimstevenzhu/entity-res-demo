        \node[box, fill=orange!10, below=of score1] (agg1) {Scalar Aggregation $\mathcal{A}(P)$ (Sum, Mean, Noisy-OR, Max)};
        \node[box, fill=red!10, below=of agg1] (global1) {Global Decision};
        \draw[->, thick] (input1) -- (local1);
        \draw[->, thick] (local1) -- (score1);
